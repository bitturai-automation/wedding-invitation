{
  "cleanUrls": true,
  "headers": [
    {"source": "/(.*)\\.(woff2)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]},
    {"source": "/(.*)\\.(mp4|mp3|jpg|png)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400"}]}
  ]
}
